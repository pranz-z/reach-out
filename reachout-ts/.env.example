# --- identity (required before anything sends) ---
SENDER_NAME="Your Name"
SENDER_ADDRESS=you@example.com
REPLY_TO_ADDRESS=
PORTFOLIO_URL=https://example.com/portfolio

# --- database (shares the Laravel app's SQLite file by default) ---
DB_PATH=../reachout/database/database.sqlite

# --- session ---
SESSION_SECRET=change-me-random-32+chars

# --- LLM (OpenAI-compatible; Groq free tier is the default) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=120
# Optional fallback provider (e.g. local Ollama)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=qwen3.5:4b

# --- agent limits ---
AGENT_MAX_STEPS=40
AGENT_MAX_LEADS_PER_RUN=3
AGENT_FULL_TOOL_RESULTS=3
AGENT_RUN_MINUTES=30

# --- discovery ---
DISCOVERY_PROVIDER=osm          # osm (free) | google (needs PLACES_API_KEY)
DISCOVERY_PROVINCE=Pampanga
DISCOVERY_START_HOUR=8
REVIEW_QUEUE_MAX=20
PLACES_API_KEY=

# --- web search for Facebook link lookup (optional) ---
SEARCH_PROVIDER=brave           # brave | google
SEARCH_API_KEY=
SEARCH_ENGINE_ID=               # google custom search engine id

# --- OpenStreetMap / Overpass ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_CACHE_HOURS=24
OVERPASS_MIN_DELAY_MS=1000
OVERPASS_LIMIT=15

# --- sending ---
MAIL_MAILER=log                 # MUST stay 'log' in dev — 'smtp' sends real email
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
DAILY_SEND_LIMIT=20
SEND_WINDOW_START=9             # Asia/Manila, Mon-Fri
SEND_WINDOW_END=17
SEND_WARMUP_WEEK1=5
SEND_WARMUP_WEEK2=10
SEND_MIN_DELAY_SECONDS=180
SEND_MAX_DELAY_SECONDS=720
FOLLOWUP_AFTER_DAYS=7
REQUIRE_APPROVAL=true           # keep true: nothing sends without human approval

# --- reply handling ---
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_ENCRYPTION=ssl
IMAP_FOLDER=INBOX
LLM_REPLY_SUGGEST=false
SOFT_BOUNCE_THRESHOLD=3

# --- daily API budgets ---
LLM_DAILY_CALLS=500
LLM_DAILY_TOKENS=180000
PLACES_DAILY_CALLS=50
SEARCH_DAILY_CALLS=50
OSM_DAILY_CALLS=60

# --- resilient http ---
RESILIENT_MAX_ATTEMPTS=3
RESILIENT_BREAKER_FAILURES=3
RESILIENT_BREAKER_SECONDS=900
RESILIENT_RETRY_AFTER_CAP=60

# --- retention + backups (reachout prune / backup) ---
RETENTION_SNIPPET_DAYS=90
RETENTION_DEAD_LEAD_DAYS=180
BACKUP_KEEP=14
