# --- Who is sending ---
SENDER_NAME="Franz Michael Cayanan"
SENDER_ADDRESS=<your new gmail address>
REPLY_TO_ADDRESS=<your new gmail address>
PORTFOLIO_URL=https://frami-devplace.vercel.app

# --- LLM: Groq (main model) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=<your groq api key>
LLM_MODEL=openai/gpt-oss-120b

# --- Agent limits (keep small on the free tier) ---
AGENT_MAX_STEPS=40
AGENT_MAX_LEADS_PER_RUN=3

# --- Lead discovery / Facebook lookup (not used on the free stack) ---
PLACES_API_KEY=
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# --- Sending through Gmail ---
# Keep MAIL_MAILER=log until the self-test in step 5. Nothing really sends while it is "log".
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=<your new gmail address>
MAIL_PASSWORD=<16-character app password, no spaces>
MAIL_FROM_ADDRESS=<your new gmail address>
MAIL_FROM_NAME="Franz Michael Cayanan"
DAILY_SEND_LIMIT=20
REQUIRE_APPROVAL=true

# --- Gmail reply inbox ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USER=<your new gmail address>
IMAP_PASSWORD=<same 16-character app password, no spaces>
IMAP_FOLDER=INBOX