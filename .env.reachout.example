# Append these to your Laravel .env

# --- Who is sending ---
SENDER_NAME="Franz Michael Cayanan"
SENDER_ADDRESS=you@yourdomain.example
PORTFOLIO_URL=https://your-portfolio.example

# --- LLM (any OpenAI-compatible endpoint) ---
# Local Ollama:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# The agent loop needs a model that follows tool schemas reliably.
# If a local 7B model is inconsistent, point these three at a hosted model
# with tool calling (official free API key or a cheap paid one).

# --- Agent limits ---
AGENT_MAX_STEPS=40
AGENT_MAX_LEADS_PER_RUN=10

# --- Lead discovery and Facebook link lookup ---
PLACES_API_KEY=
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# --- Sending (milestone 4) ---
DAILY_SEND_LIMIT=20
REQUIRE_APPROVAL=true
